import os
import json
from datetime import datetime
from dotenv import load_dotenv
from fastapi import FastAPI, Request, Depends, HTTPException
from fastapi.responses import HTMLResponse
from functools import lru_cache
from pydantic import BaseModel
from typing import Literal

from app.models import Ticket
from app.sources.zendesk import normalize_zendesk_payload
from app.sources.jira import normalize_jira_payload
from app.knowledge_base import ResolvedTicketKB
from app.embeddings import FastEmbedder
from app.llm_judge import TriageJudge
from app.router import route, TicketActionSink, CompositeActionSink
from app.jira_action_sink import JiraActionSink
from app.zendesk_action_sink import ZendeskActionSink
from app.demo_action_sink import DemoActionSink
from app.webhook_auth import verify_zendesk_signature, verify_jira_signature
from app.idempotency import (
    IdempotencyStore, InMemoryIdempotencyStore,
    compute_zendesk_idempotency_key, compute_jira_idempotency_key,
)
from app.write_back import (
    PendingEscalationStore, InMemoryPendingEscalationStore,
    write_back_auto_resolved, record_escalation, resolve_escalation,
    EscalationNotFoundError,
)

load_dotenv(override=True)

app = FastAPI(title="Ticket Triage Gateway")


async def require_valid_zendesk_signature(request: Request) -> bytes:
    raw_body = await request.body()
    secret = os.environ["ZENDESK_WEBHOOK_SECRET"]
    signature = request.headers.get("x-zendesk-webhook-signature", "")
    timestamp = request.headers.get("x-zendesk-webhook-signature-timestamp", "")
    if not verify_zendesk_signature(raw_body, timestamp, signature, secret):
        raise HTTPException(status_code=401, detail="invalid Zendesk webhook signature")
    return raw_body


async def require_valid_jira_signature(request: Request) -> bytes:
    raw_body = await request.body()
    secret = os.environ["JIRA_WEBHOOK_SECRET"]
    signature_header = request.headers.get("x-hub-signature", "")
    if not verify_jira_signature(raw_body, signature_header, secret):
        raise HTTPException(status_code=401, detail="invalid Jira webhook signature")
    return raw_body


@lru_cache
def get_kb() -> ResolvedTicketKB:
    return ResolvedTicketKB(embedder=FastEmbedder(), persist_path="./chroma_data")


@lru_cache
def get_judge() -> TriageJudge:
    return TriageJudge()


@lru_cache
def get_action_sink() -> TicketActionSink:
    return CompositeActionSink(
        customer_sink=ZendeskActionSink(),
        escalation_sink=JiraActionSink()
        )


@lru_cache
def get_demo_action_sink() -> TicketActionSink:
    """Demo-only sink: describes actions instead of making real network
    calls, but wrapped in the SAME CompositeActionSink used for real
    traffic, so the demo UI exercises the identical source-aware
    routing logic (Jira-sourced auto-resolve -> Jira comment, not a
    fake Zendesk reply) rather than a simplified stand-in."""
    demo = DemoActionSink()
    return CompositeActionSink(customer_sink=demo, escalation_sink=demo)


@lru_cache
def get_idempotency_store() -> IdempotencyStore:
    return InMemoryIdempotencyStore()


@lru_cache
def get_pending_escalation_store() -> PendingEscalationStore:
    return InMemoryPendingEscalationStore()


async def check_zendesk_idempotency(
    raw_body: bytes = Depends(require_valid_zendesk_signature),
    store: IdempotencyStore = Depends(get_idempotency_store),
) -> tuple[bytes, str, IdempotencyStore]:
    return raw_body, compute_zendesk_idempotency_key(raw_body), store


async def check_jira_idempotency(
    request: Request,
    raw_body: bytes = Depends(require_valid_jira_signature),
    store: IdempotencyStore = Depends(get_idempotency_store),
) -> tuple[bytes, str, IdempotencyStore]:
    identifier = request.headers.get("x-atlassian-webhook-identifier", "")
    if identifier:
        key = compute_jira_idempotency_key(identifier)
    else:
        import hashlib
        key = f"jira:no-identifier:{hashlib.sha256(raw_body).hexdigest()}"
    return raw_body, key, store


def _handle_ticket(ticket, kb: ResolvedTicketKB, judge: TriageJudge, sink: TicketActionSink,
                    pending_store: PendingEscalationStore) -> dict:
    matches = kb.query(ticket.to_embedding_text(), top_k=3)

    if not matches:
        return {"status": "received", "source_id": ticket.source_id,
                "matches": [], "decision": None, "routing": None, "write_back": None}

    decision = judge.judge(ticket, matches)
    routing_result = route(ticket, decision, matches, sink)

    if routing_result.final_action == "auto_resolve":
        write_back_auto_resolved(ticket, decision, kb)
        write_back_info = {"action": "auto_written_back", "origin": "auto_resolved", "verified": False}
    else:
        record_escalation(ticket, pending_store)
        write_back_info = {"action": "recorded_as_pending_escalation"}

    return {
        "status": "received", "source_id": ticket.source_id, "matches": matches,
        "decision": decision.model_dump(), "routing": routing_result.model_dump(),
        "write_back": write_back_info,
    }


@app.post("/webhooks/zendesk")
async def zendesk_webhook(
    idempotency_data: tuple = Depends(check_zendesk_idempotency),
    kb: ResolvedTicketKB = Depends(get_kb),
    judge: TriageJudge = Depends(get_judge),
    sink: TicketActionSink = Depends(get_action_sink),
    pending_store: PendingEscalationStore = Depends(get_pending_escalation_store),
):
    raw_body, idempotency_key, store = idempotency_data
    payload = json.loads(raw_body)
    if store.is_duplicate(idempotency_key):
        ticket_id = str(payload.get("ticket", {}).get("id", "unknown"))
        return {"status": "duplicate_skipped", "source_id": ticket_id}
    ticket = normalize_zendesk_payload(payload)
    result = _handle_ticket(ticket, kb, judge, sink, pending_store)
    store.mark_processed(idempotency_key)
    return result


@app.post("/webhooks/jira")
async def jira_webhook(
    idempotency_data: tuple = Depends(check_jira_idempotency),
    kb: ResolvedTicketKB = Depends(get_kb),
    judge: TriageJudge = Depends(get_judge),
    sink: TicketActionSink = Depends(get_action_sink),
    pending_store: PendingEscalationStore = Depends(get_pending_escalation_store),
):
    raw_body, idempotency_key, store = idempotency_data
    payload = json.loads(raw_body)
    if store.is_duplicate(idempotency_key):
        issue = payload.get("issue", payload)
        ticket_id = str(issue.get("key", "unknown"))
        return {"status": "duplicate_skipped", "source_id": ticket_id}
    issue = payload.get("issue", payload)
    ticket = normalize_jira_payload(issue)
    result = _handle_ticket(ticket, kb, judge, sink, pending_store)
    store.mark_processed(idempotency_key)
    return result


class ResolveTicketRequest(BaseModel):
    resolution: str


@app.post("/tickets/{source_id}/resolve")
async def resolve_ticket(
    source_id: str, body: ResolveTicketRequest,
    kb: ResolvedTicketKB = Depends(get_kb),
    pending_store: PendingEscalationStore = Depends(get_pending_escalation_store),
):
    try:
        resolved_ticket = resolve_escalation(source_id, body.resolution, pending_store, kb)
    except EscalationNotFoundError as e:
        raise HTTPException(status_code=404, detail=str(e))
    return {"status": "resolved_and_written_back", "source_id": resolved_ticket.source_id, "origin": "human_verified"}


class DemoTriageRequest(BaseModel):
    subject: str
    description: str
    source: Literal["zendesk", "jira"] = "zendesk"


@app.post("/demo/triage")
async def demo_triage(
    body: DemoTriageRequest,
    kb: ResolvedTicketKB = Depends(get_kb),
    judge: TriageJudge = Depends(get_judge),
    sink: TicketActionSink = Depends(get_demo_action_sink),
    pending_store: PendingEscalationStore = Depends(get_pending_escalation_store),
):
    """
    Demo endpoint powering the /demo UI. Reuses the REAL pipeline
    (_handle_ticket - the exact same function every webhook handler
    calls) with a synthetic ticket built from form input. Real
    retrieval, real judge reasoning, real routing, real write-back into
    the same persistent KB - only the action sink is swapped for one
    that describes actions instead of hitting real Zendesk/Jira.
    """
    source_id = f"DEMO-{int(datetime.now().timestamp() * 1000)}"
    ticket = Ticket(
        source=body.source, source_id=source_id, subject=body.subject,
        description=body.description, created_at=datetime.now(),
    )
    result = _handle_ticket(ticket, kb, judge, sink, pending_store)
    return result


@app.get("/demo", response_class=HTMLResponse)
async def demo_page():
    return DEMO_HTML


DEMO_HTML = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Ticket Triage RAG - Live Demo</title>
<style>
  :root {
    --bg: #0f1115; --panel: #161920; --border: #262a33; --text: #e6e8eb;
    --muted: #8b929e; --accent: #5b8def; --green: #34c37a; --amber: #e0a72e;
    --red: #e0554f; --mono: 'SF Mono', Consolas, monospace;
  }
  * { box-sizing: border-box; }
  body {
    background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    margin: 0; padding: 40px 20px; line-height: 1.5;
  }
  .wrap { max-width: 760px; margin: 0 auto; }
  h1 { font-size: 22px; margin-bottom: 4px; }
  .sub { color: var(--muted); font-size: 14px; margin-bottom: 28px; }
  .panel {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 10px; padding: 20px; margin-bottom: 20px;
  }
  label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 6px; margin-top: 14px; }
  label:first-child { margin-top: 0; }
  input[type=text], textarea, select {
    width: 100%; background: #0d0f13; border: 1px solid var(--border);
    color: var(--text); border-radius: 6px; padding: 10px 12px; font-size: 14px;
    font-family: inherit;
  }
  textarea { min-height: 90px; resize: vertical; }
  button {
    background: var(--accent); color: white; border: none; border-radius: 6px;
    padding: 11px 20px; font-size: 14px; font-weight: 600; cursor: pointer;
    margin-top: 18px;
  }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  button.secondary { background: #2a2e38; }
  .row { display: flex; gap: 20px; }
  .row > div { flex: 1; }
  h2 { font-size: 15px; margin: 0 0 12px 0; color: var(--text); }
  .match {
    border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px;
    margin-bottom: 8px; background: #0d0f13;
  }
  .match-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .match-id { font-family: var(--mono); font-size: 12px; color: var(--accent); }
  .distance { font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .match-subject { font-size: 13px; margin-bottom: 4px; }
  .badge {
    display: inline-block; font-size: 10px; padding: 2px 7px; border-radius: 10px;
    font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em;
  }
  .badge-verified { background: rgba(52,195,122,0.15); color: var(--green); }
  .badge-unverified { background: rgba(224,167,46,0.15); color: var(--amber); }
  .badge-seed { background: rgba(139,146,158,0.15); color: var(--muted); }
  .confidence-bar-track { background: #0d0f13; border-radius: 6px; height: 8px; overflow: hidden; margin: 6px 0 4px 0; }
  .confidence-bar-fill { height: 100%; border-radius: 6px; }
  .decision-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
  .action-badge { font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 6px; }
  .action-auto { background: rgba(52,195,122,0.15); color: var(--green); }
  .action-escalate { background: rgba(224,85,79,0.15); color: var(--red); }
  .reasoning { font-size: 13px; color: var(--text); background: #0d0f13; border-radius: 6px; padding: 12px; border: 1px solid var(--border); }
  .draft-box { font-size: 13px; white-space: pre-wrap; background: #0d0f13; border-radius: 6px; padding: 12px; border: 1px solid var(--border); margin-top: 10px; }
  .override-note { font-size: 12px; color: var(--amber); margin-top: 8px; }
  .empty-state { color: var(--muted); font-size: 13px; text-align: center; padding: 20px 0; }
  .error-box { background: rgba(224,85,79,0.1); border: 1px solid var(--red); border-radius: 8px; padding: 14px; font-size: 13px; color: var(--red); }
  .loading { color: var(--muted); font-size: 13px; text-align: center; padding: 30px 0; }
  .resolve-panel { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); }
  .success-note { color: var(--green); font-size: 13px; margin-top: 10px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>Ticket Triage RAG - Live Demo</h1>
  <div class="sub">Runs the real retrieval + reasoning + routing pipeline. No real Zendesk/Jira calls are made from here.</div>

  <div class="panel">
    <label>Source</label>
    <select id="source">
      <option value="zendesk">Zendesk (customer ticket)</option>
      <option value="jira">Jira (engineering bug)</option>
    </select>

    <label>Subject</label>
    <input type="text" id="subject" placeholder="e.g. Export to CSV button does nothing">

    <label>Description</label>
    <textarea id="description" placeholder="Describe the problem as the customer or engineer would..."></textarea>

    <button id="submitBtn" onclick="submitTicket()">Run through pipeline</button>
  </div>

  <div id="results"></div>
</div>

<script>
async function submitTicket() {
  const subject = document.getElementById('subject').value.trim();
  const description = document.getElementById('description').value.trim();
  const source = document.getElementById('source').value;
  const btn = document.getElementById('submitBtn');
  const results = document.getElementById('results');

  if (!subject || !description) {
    results.innerHTML = '<div class="panel"><div class="error-box">Please fill in both subject and description.</div></div>';
    return;
  }

  btn.disabled = true;
  results.innerHTML = '<div class="panel"><div class="loading">Running retrieval, judge reasoning, and routing...</div></div>';

  try {
    const resp = await fetch('/demo/triage', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({subject, description, source})
    });
    const data = await resp.json();
    if (!resp.ok) {
      results.innerHTML = '<div class="panel"><div class="error-box">' + (data.detail || 'Request failed') + '</div></div>';
      return;
    }
    renderResults(data);
  } catch (e) {
    results.innerHTML = '<div class="panel"><div class="error-box">Network error: ' + e.message + '</div></div>';
  } finally {
    btn.disabled = false;
  }
}

function originBadge(origin, verified) {
  if (origin === 'human_verified') return '<span class="badge badge-verified">human verified</span>';
  if (origin === 'auto_resolved') return '<span class="badge badge-unverified">auto-resolved, unverified</span>';
  return '<span class="badge badge-seed">seed data</span>';
}

function confidenceColor(conf) {
  if (conf >= 75) return 'var(--green)';
  if (conf >= 40) return 'var(--amber)';
  return 'var(--red)';
}

function renderResults(data) {
  const results = document.getElementById('results');
  let html = '';

  // Matches panel
  html += '<div class="panel"><h2>Retrieved candidates</h2>';
  if (!data.matches || data.matches.length === 0) {
    html += '<div class="empty-state">No matches found in the knowledge base yet.</div>';
  } else {
    for (const m of data.matches) {
      html += `<div class="match">
        <div class="match-top">
          <span class="match-id">${m.ticket_id}</span>
          <span class="distance">distance ${m.distance.toFixed(4)}</span>
        </div>
        <div class="match-subject">${escapeHtml(m.subject)}</div>
        ${originBadge(m.origin, m.verified)}
      </div>`;
    }
  }
  html += '</div>';

  // Decision panel
  if (data.decision) {
    const d = data.decision;
    const color = confidenceColor(d.confidence);
    html += `<div class="panel"><h2>Judge decision</h2>
      <div class="decision-row">
        <span class="action-badge ${d.recommended_action === 'auto_resolve' ? 'action-auto' : 'action-escalate'}">
          ${d.recommended_action === 'auto_resolve' ? 'Auto-resolve' : 'Escalate to human'}
        </span>
        <span style="font-family: var(--mono); font-size: 13px; color: ${color};">confidence ${d.confidence}</span>
      </div>
      <div class="confidence-bar-track"><div class="confidence-bar-fill" style="width: ${d.confidence}%; background: ${color};"></div></div>
      <div class="reasoning">${escapeHtml(d.reasoning)}</div>
      ${d.customer_facing_draft ? '<div class="draft-box">' + escapeHtml(d.customer_facing_draft) + '</div>' : ''}
    </div>`;
  }

  // Routing panel
  if (data.routing) {
    const r = data.routing;
    html += `<div class="panel"><h2>Final routing</h2>
      <span class="action-badge ${r.final_action === 'auto_resolve' ? 'action-auto' : 'action-escalate'}">
        ${r.final_action === 'auto_resolve' ? 'Auto-resolved' : 'Escalated'}
      </span>`;
    if (r.override_applied) {
      html += `<div class="override-note">Safety-floor override: ${escapeHtml(r.override_reason)}</div>`;
    }
    html += `<div style="margin-top: 10px; font-size: 12px; color: var(--muted); font-family: var(--mono);">${escapeHtml(JSON.stringify(r.receipt))}</div>`;
    html += '</div>';
  }

  // Write-back panel + resolve form for escalations
  if (data.write_back) {
    html += '<div class="panel"><h2>Write-back</h2>';
    if (data.write_back.action === 'auto_written_back') {
      html += '<div class="empty-state" style="text-align:left;">Written back to the knowledge base immediately as <b>unverified</b> precedent (origin=auto_resolved). It will now show up as a candidate for future similar tickets.</div>';
    } else if (data.write_back.action === 'recorded_as_pending_escalation') {
      html += `<div class="empty-state" style="text-align:left;">Not written back yet - held as a pending escalation.
        Submit the real resolution below to write it back as trusted (human_verified) precedent.</div>
        <div class="resolve-panel">
          <label>Resolution (what actually fixed it)</label>
          <textarea id="resolutionText" placeholder="e.g. Root cause was a config typo, corrected manually."></textarea>
          <button class="secondary" onclick="resolveTicket('${data.source_id}')">Submit resolution</button>
          <div id="resolveResult"></div>
        </div>`;
    }
    html += '</div>';
  }

  results.innerHTML = html;
}

async function resolveTicket(sourceId) {
  const resolution = document.getElementById('resolutionText').value.trim();
  const resultDiv = document.getElementById('resolveResult');
  if (!resolution) {
    resultDiv.innerHTML = '<div class="error-box" style="margin-top:10px;">Please enter a resolution.</div>';
    return;
  }
  try {
    const resp = await fetch(`/tickets/${sourceId}/resolve`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({resolution})
    });
    const data = await resp.json();
    if (!resp.ok) {
      resultDiv.innerHTML = '<div class="error-box" style="margin-top:10px;">' + (data.detail || 'Failed') + '</div>';
      return;
    }
    resultDiv.innerHTML = '<div class="success-note">Written back as human_verified precedent. Try a similar ticket above to see it retrieved.</div>';
  } catch (e) {
    resultDiv.innerHTML = '<div class="error-box" style="margin-top:10px;">Network error: ' + e.message + '</div>';
  }
}

function escapeHtml(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}
</script>
</body>
</html>
"""


@app.get("/health")
async def health():
    return {"status": "ok"}